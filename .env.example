# Server only. Never put credentials in public/ or Git.
# Vercel independent deployment: use a private Blob store and a Turso database.
# Copy to .env.local for migrations/admin commands; configure sensitive values
# in Vercel Production/Preview environment variables before deploying.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
# invite (default), open, or disabled. Leave invitation value out of Git.
AUTH_REGISTRATION_MODE=invite
AUTH_INVITE_CODE=
# Default 7 days, clamped to 300..2592000 seconds.
AUTH_SESSION_TTL_SECONDS=604800
# Shared DB limits across login/register: attempts per 15-minute window.
AUTH_RATE_IP_LIMIT=30
AUTH_RATE_EMAIL_LIMIT=10
# Existing model configuration works in both Vercel and Sites deployments.
DASHSCOPE_API_KEY=
QWEN_REGION=cn-beijing
QWEN_WORKSPACE_ID=
QWEN_TEXT_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_IMAGE_MODEL=qwen-image-2.0-pro
COPY_PROVIDER=qwen
IMAGE_PROVIDER=qwen
# Portdan image generation only; keep the Qwen key for product analysis/copy.
PORTDAN_API_KEY=
PORTDAN_IMAGE_MODEL=gpt-image-2.5-flare【1k快速1毛】
# Set daily trial limits before enabling calls.
AI_ENABLED=false
AI_COPY_DAILY_LIMIT=0
AI_IMAGE_DAILY_LIMIT=0
# Optional server-side observability. Preview defaults to disabled.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
