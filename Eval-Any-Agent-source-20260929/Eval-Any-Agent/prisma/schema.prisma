generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  datasets        Dataset[]
  profiles        MappingProfile[]
  tasks           EvalTask[]
  llmProviders    LlmProviderConfig[]
  evaluators      Evaluator[]
  evaluationTasks EvaluationTask[]
  scheduledTasks ScheduledTask[]
  evaluationReviews EvaluationReview[]
}

model Dataset {
  id        String   @id @default(cuid())
  userId    String
  name      String
  fileType  String
  rowCount  Int
  columns   String
  rows      String
  createdAt DateTime @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  profiles MappingProfile[]
  tasks    EvalTask[]
  scheduledTasks ScheduledTask[]

  @@index([userId])
}

model MappingProfile {
  id                  String   @id @default(cuid())
  userId              String
  datasetId           String?
  name                String
  upstreamUrl         String
  method              String   @default("POST")
  requestTemplate     String
  headers             String
  inputBindings       String
  extractRules        String
  expectedSchema      String?
  streamProtocol      String   @default("auto")
  doneStrategy        String   @default("auto")
  doneRules           String
  doneRequired        Boolean  @default(false)
  timeoutMs           Int      @default(60000)
  retryCount          Int      @default(2)
  idleTimeoutMs       Int      @default(15000)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset Dataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  tasks   EvalTask[]
  scheduledTasks ScheduledTask[]

  @@index([userId])
  @@index([datasetId])
}

model EvalTask {
  id          String   @id @default(cuid())
  userId      String
  datasetId   String
  profileId   String
  status      String
  concurrency Int
  timeoutMs   Int
  retryCount  Int
  conversationIdMode String @default("preserve")
  conversationIdEvery Int @default(1)
  totalRows   Int
  successRows Int      @default(0)
  failedRows  Int      @default(0)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset         Dataset           @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  profile         MappingProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  results         EvalResult[]
  evaluationTasks EvaluationTask[]

  @@index([userId])
  @@index([datasetId])
  @@index([profileId])
}

model EvalResult {
  id                 String   @id @default(cuid())
  taskId              String
  rowIndex            Int
  inputData           String
  requestPayload      String?
  outputs             String
  ttftMs              Int?
  latencyMs           Int?
  status              String
  errorType           String?
  errorMessage        String?
  endReason           String?
  ruleHit             String?
  rawTrace            String?
  createdAt           DateTime @default(now())

  task              EvalTask            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  evaluationResults EvaluationResult[]

  @@index([taskId])
  @@index([rowIndex])
}

model LlmProviderConfig {
  id           String   @id @default(cuid())
  userId       String
  name         String
  providerType String   @default("openai_compatible")
  baseUrl      String
  apiKeyEncrypted String
  defaultModel String
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluators Evaluator[]

  @@index([userId])
}

model Evaluator {
  id                 String   @id @default(cuid())
  userId             String
  providerConfigId   String
  name               String
  model              String
  systemPrompt       String
  userPromptTemplate String
  thinkingEnabled    Boolean  @default(false)
  scoreMin           Float    @default(0)
  scoreMax           Float    @default(100)
  passThreshold      Float    @default(60)
  notifyDingTalk     Boolean  @default(false)
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConfig    LlmProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)
  evaluationTasks   EvaluationTask[]

  @@index([userId])
  @@index([providerConfigId])
}

model EvaluationTask {
  id          String   @id @default(cuid())
  userId      String
  sourceTaskId String
  evaluatorId String
  status      String
  totalRows   Int
  successRows Int      @default(0)
  failedRows  Int      @default(0)
  skippedRows Int      @default(0)
  notifyDingTalk Boolean @default(false)
  avgScore    Float?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceTask    EvalTask           @relation(fields: [sourceTaskId], references: [id], onDelete: Cascade)
  evaluator    Evaluator          @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  results      EvaluationResult[]

  @@index([userId])
  @@index([sourceTaskId])
  @@index([evaluatorId])
}

model EvaluationResult {
  id               String   @id @default(cuid())
  evaluationTaskId String
  sourceResultId   String
  rowIndex         Int
  score            Float?
  passed           Boolean?
  reason           String?
  status           String
  errorType        String?
  errorMessage     String?
  promptSnapshot   String
  rawResponse      String?
  createdAt        DateTime @default(now())
  reviewVersion    Int      @default(0)
  reviewVerdict    String?

  evaluationTask EvaluationTask @relation(fields: [evaluationTaskId], references: [id], onDelete: Cascade)
  sourceResult    EvalResult     @relation(fields: [sourceResultId], references: [id], onDelete: Cascade)
  reviews         EvaluationReview[]

  @@index([evaluationTaskId])
  @@index([sourceResultId])
  @@index([rowIndex])
  @@index([evaluationTaskId, reviewVerdict])
}

model EvaluationReview {
  id                String   @id @default(cuid())
  submissionKey     String   @unique
  evaluationResultId String
  reviewerId        String
  revision          Int
  verdict           String
  reason            String
  correctedScore    Float?
  correctedPassed   Boolean?
  aiScore           Float?
  aiPassed          Boolean?
  aiReason          String?
  createdAt         DateTime @default(now())

  evaluationResult EvaluationResult @relation(fields: [evaluationResultId], references: [id], onDelete: Cascade)
  reviewer         User             @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([evaluationResultId, revision])
  @@index([reviewerId])
}

model ScheduledTask {
  id String @id @default(cuid())
  userId String
  name String
  datasetId String
  profileId String
  concurrency Int @default(20)
  timeoutMs Int @default(60000)
  retryCount Int @default(2)
  conversationIdMode String @default("preserve")
  conversationIdEvery Int @default(1)
  scheduleType String
  cronExpr String?
  intervalMs Int?
  timezone String @default("Asia/Shanghai")
  notifyDingTalk Boolean @default(true)
  enabled Boolean @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  profile MappingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([userId, enabled, nextRunAt])
}
